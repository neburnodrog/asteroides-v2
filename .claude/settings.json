{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm start)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx webpack *)",
      "Bash(npx gh-pages *)",
      "Read(./src/**)",
      "Read(./dist/**)",
      "Read(./webpack.config.js)",
      "Read(./.babelrc)",
      "Read(./package.json)",
      "Read(./.nvmrc)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
